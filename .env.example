# ==========================================
# Odyssey Environment Variables Template
# ==========================================
# Copy this file to .env and fill in the values.
# Do NOT commit the actual .env file to version control!

# Server Configuration
PORT=8080

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/odyssey_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_db_password

# JWT Authentication
JWT_SECRET=your_super_secure_jwt_secret_key_at_least_256_bits_long
JWT_EXPIRATION=86400000

# OAuth2 Provider Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/success

# AWS / LocalStack Config
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=http://localhost:4566
AWS_S3_BUCKET=odyssey-uploads
AWS_SES_ENDPOINT=http://localhost:4566

# Email SMTP Setup (Gmail example)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Frontend Config
VITE_API_URL=http://localhost:8080/api
VITE_AI_PROXY=false
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_AUTH_DEMO=false
